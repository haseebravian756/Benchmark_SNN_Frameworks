# Virtual environment (never commit — rebuild it from requirements.txt instead)
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Datasets and the Tonic disk cache (huge, regenerable)
data/
cache/

# Scratch output from local runs. Leading slash = ROOT ONLY, so that
# experiments/exN/results/ is NOT caught by this and stays tracked — those CSVs
# are the actual scientific output and belong in version control.
/results/

# Landing zones for files pulled off Colab before collect_results.py files them
# (temp_colab, temp_colab_1, temp_colab_seed2, ...)
temp_colab*/

# Stray images anywhere...
*.png
# ...except the ones that are part of an experiment record or the docs
!experiments/**/*.png
!docs/*.png

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
