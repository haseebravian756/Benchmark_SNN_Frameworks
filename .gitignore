# Virtual environment (never commit — rebuild it from requirements.txt instead)
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Datasets and the Tonic disk cache (huge, regenerable)
data/
cache/


/results/
/local_runs/
/local_docs/

# Landing zones for files pulled off Colab before collect_results.py files them
# (temp_colab, temp_colab_1, temp_colab_seed2, ...)
temp_colab*/

# Stray images anywhere...
*.png

# ...except the handful the README embeds, which a GitHub visitor must be able to
# see. Regenerate with: python make_readme_figures.py --experiment ex1
!docs/figures/*.png

# Editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
